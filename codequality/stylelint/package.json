{
  "name": "@merkle-open/stylelint-config",
  "description": "Shared stylelint config",
  "version": "5.0.1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/merkle-open/frontend-defaults.git"
  },
  "main": "./index.js",
  "license": "MIT",
  "author": "Merkle Inc.",
  "private": false,
  "engines": {
    "node": ">=20.19.0"
  },
  "files": [
    "README.md",
    "LICENSE",
    "index.js"
  ],
  "peerDependencies": {
    "stylelint": ">=17 <18"
  },
  "devDependencies": {
    "stylelint": "17.14.1"
  },
  "dependencies": {
    "@namics/stylelint-bem": "11.1.0",
    "stylelint-config-standard-scss": "17.0.0"
  },
  "scripts": {
    "lint:css": "stylelint __test__/**/*.*ss --allow-empty-input",
